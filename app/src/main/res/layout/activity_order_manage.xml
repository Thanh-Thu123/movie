<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp"
    tools:context=".ui.admin.booking.OrderManage">

    <!-- Nút quay lại -->

    <!-- Tiêu đề -->

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="27dp"
        android:layout_height="47dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Quay lại"
        android:src="@drawable/ic_back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_manage_orders"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quản lý Đơn Đặt"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_back"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintHorizontal_bias="0.5" />

    <!-- Ô tìm kiếm đơn đặt -->
    <LinearLayout
        android:id="@+id/search_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_manage_orders"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etSearchBooking"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Tìm kiếm đơn"
            android:padding="12dp"
            android:background="@drawable/search_edit_background"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:inputType="text" />

        <ImageButton
            android:id="@+id/btnSearchBooking"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/search_button_background"
            android:src="@drawable/ic_search_white"
            android:contentDescription="Tìm kiếm"
            android:scaleType="centerInside"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Danh sách đơn đặt -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBookings"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/search_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
