<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="40dp"
    tools:context=".ui.admin.movie.PriceManageFragment">

    <!-- Nút quay lại -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back_arrow"
        android:scaleType="centerInside"
        android:contentDescription="Quay lại"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Tiêu đề -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quản lý Giá Vé"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        app:layout_constraintHorizontal_bias="0.5" />

    <!-- Tabs -->
    <LinearLayout
        android:id="@+id/tab_button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_tab_surcharge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Phụ thu"
            android:textAllCaps="false"
            android:backgroundTint="@color/orange"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btn_tab_movie_price"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Giá phim"
            android:textAllCaps="false"
            android:backgroundTint="#EEEEEE"
            android:textColor="@android:color/black" />
    </LinearLayout>

    <!-- Nội dung -->
    <FrameLayout
        android:id="@+id/tab_content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tab_button_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tab phụ thu -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/layout_surcharge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="9dp">

                <!-- Cuối tuần -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">

                        <TextView
                            android:id="@+id/tvWeekendPricing"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📅 Cuối tuần"
                            android:textSize="18sp"
                            android:textColor="#000000" />

                    </LinearLayout>
                    <!-- Trong layout_weekend_days -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="4dp">

                        <TextView
                            android:id="@+id/tvFriday"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="• Friday: +40%"
                            android:textSize="16sp"
                            android:textColor="#000000" />

                        <Button
                            android:id="@+id/btnEditFriday"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Sửa"
                            android:textSize="12sp"
                            android:textAllCaps="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="4dp">

                        <TextView
                            android:id="@+id/tvSaturday"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="• Saturday: +50%"
                            android:textSize="16sp"
                            android:textColor="#000000" />

                        <Button
                            android:id="@+id/btnEditSaturday"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Sửa"
                            android:textSize="12sp"
                            android:textAllCaps="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="4dp">

                        <TextView
                            android:id="@+id/tvSunday"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="• Sunday: +60%"
                            android:textSize="16sp"
                            android:textColor="#000000" />

                        <Button
                            android:id="@+id/btnEditSunday"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Sửa"
                            android:textSize="12sp"
                            android:textAllCaps="false" />
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/layout_weekend_days"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingBottom="8dp" />
                </LinearLayout>

                <!-- Phim hot -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="8dp"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/tvHotLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔥 Phim hot"
                        android:textSize="18sp"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/tvHotMovie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+40%"
                        android:textSize="18sp"
                        android:textColor="#FF5722"
                        android:layout_marginEnd="12dp" />

                    <Button
                        android:id="@+id/btnEditHot"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Sửa"
                        android:textSize="12sp"
                        android:textAllCaps="false" />
                </LinearLayout>

                <!-- Giờ cao điểm -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="8dp">

                        <TextView
                            android:id="@+id/tvPeakLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🕒 Giờ cao điểm"
                            android:textSize="18sp"
                            android:textColor="#000000" />

                        <TextView
                            android:id="@+id/tvPeakHour"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+30%"
                            android:textSize="18sp"
                            android:textColor="#FF5722"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/btnEditPeakPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Sửa %"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:layout_marginEnd="4dp"/>

                    </LinearLayout>



                    <Button
                        android:id="@+id/btnEditPeak"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Sửa giờ"
                        android:textSize="12sp"
                        android:textAllCaps="false" />
                    <GridLayout
                        android:id="@+id/layout_peak_hours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="4"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Tab giá phim -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_movie_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:padding="8dp" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
